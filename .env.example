# Release signing for local builds. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit it, and never commit the keystore itself.
# With any of these unset, release builds fall back to the debug key and Gradle
# logs "notif-filter: ANDROID_KEYSTORE_* unset, release builds are debug-signed".
#
# The keystore is PKCS12, and the store and key share one password.
# CI reads the same three names from GitHub Actions secrets.

# Absolute path to the PKCS12 keystore.
ANDROID_KEYSTORE_PATH=

# Password for both the store and the key.
ANDROID_KEYSTORE_PASSWORD=

# Alias of the key inside the keystore.
ANDROID_KEY_ALIAS=
